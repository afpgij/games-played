APP_ENV=production
APP_HOST=127.0.0.1
APP_PORT=8002

# Postgres (DB nueva, separada de scmining_db)
DATABASE_URL=postgresql+psycopg://games:CHANGE_ME@127.0.0.1:5432/games_db

# JWT V2 (mismo patron que scmining)
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
REFRESH_TOKEN_DAYS_REMEMBER=90

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# URL publica del frontend (para redirects OAuth)
FRONTEND_URL=https://games.tudominio.com
# URL publica del backend (para callbacks OAuth)
BACKEND_URL=https://games.tudominio.com/api

# RAWG
RAWG_API_KEY=

# Cookies
COOKIE_DOMAIN=games.tudominio.com
COOKIE_SECURE=true
