APP_ENV=production
APP_HOST=127.0.0.1
APP_PORT=8002

# Postgres (DB nueva, separada de scmining_db)
DATABASE_URL=postgresql+psycopg://games:CHANGE_ME@127.0.0.1:5432/games_db

# JWT V2 (mismo patron que scmining)
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
REFRESH_TOKEN_DAYS_REMEMBER=90

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# URL publica del frontend (para redirects OAuth)
FRONTEND_URL=https://games-played.duckdns.org
# URL publica del backend (para callbacks OAuth)
BACKEND_URL=https://games-played.duckdns.org/api

# RAWG
RAWG_API_KEY=

# Cookies
# IMPORTANTE: duckdns.org esta en la Public Suffix List -> NO se puede
# fijar COOKIE_DOMAIN a duckdns.org ni a games-played.duckdns.org compartido.
# Dejar vacio = cookie host-only para games-played.duckdns.org (correcto).
COOKIE_DOMAIN=
COOKIE_SECURE=true
