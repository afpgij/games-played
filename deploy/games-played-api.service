[Unit]
Description=Games Played FastAPI backend
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=games
Group=games
WorkingDirectory=/opt/games-played/backend
EnvironmentFile=/opt/games-played/backend/.env
ExecStart=/opt/games-played/backend/.venv/bin/uvicorn app.main:app \
  --host 127.0.0.1 --port 8002 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=5
# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
